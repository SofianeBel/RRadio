{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RRadio",
  "version": "0.1.5",
  "identifier": "com.sifly.rradio",
  "build": {
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "news",
        "title": "RRadio News",
        "url": "index.html?news",
        "width": 420,
        "height": 160,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "main",
        "title": "",
        "fullscreen": false,
        "resizable": false,
        "width": 1920,
        "height": 340,
        "x": 0,
        "y": 0,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
